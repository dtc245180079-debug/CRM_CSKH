# ============================================================
# CRM CSKH - TEMPLATE CONFIGURATION (.env.example)
# Copy this file to .env and change values before deploying
# ============================================================

# Application Environment
NODE_ENV=production
PORT=3000
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# PostgreSQL Database
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=crm_db
DB_HOST=postgres
DB_PORT=5432

# pgAdmin Administration
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=replace_with_pgadmin_password

# Host Ports
APP_PORT=3003
NGINX_PORT=8080
PGADMIN_PORT=5050
PROMETHEUS_PORT=9099
GRAFANA_PORT=3001
LOKI_PORT=3100
